<Application x:Class="GameHub.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
 <SolidColorBrush x:Key="Muted" Color="#9CA9BC"/>
 <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EF607D"/><GradientStop Color="#A895F4" Offset="0.6"/><GradientStop Color="#65D4DB" Offset="1"/></LinearGradientBrush>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECF0F8"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="#EAF0FA"/><Setter Property="Background" Value="#263143"/><Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="18,18,18,8" Background="{TemplateBinding Background}" BorderBrush="#42516A" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#7ACAD8"/><Setter TargetName="Surface" Property="Background" Value="#35455C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A6F2F0"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBoxItem">
  <Setter Property="Margin" Value="6,9"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" CornerRadius="20,20,20,8" BorderBrush="#3D4B63" BorderThickness="2" Background="#1C2739"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#F77993"/><Setter TargetName="Card" Property="Effect"><Setter.Value><DropShadowEffect Color="#D95E83" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/></Setter.Value></Setter></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#88D6DF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
</Application.Resources></Application>
