<Window x:Class="GameHub.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GameHub Console" Width="1180" Height="760" MinWidth="900" MinHeight="650" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown" Loaded="OnLoaded" Closing="OnClosing" SizeChanged="OnSizeChanged">
 <Grid Margin="10">
  <Path x:Name="Shell" Stroke="{StaticResource Accent}" StrokeThickness="1.5"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F51E2637"/><GradientStop Color="#F5121723" Offset="0.65"/><GradientStop Color="#F529203C" Offset="1"/></LinearGradientBrush></Path.Fill></Path>
  <Grid x:Name="MainPanel" Margin="22">
   <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="OnDrag"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◈" FontSize="36" Foreground="#F47891" Margin="0,0,13,0"/><StackPanel><TextBlock Text="GAME HUB" FontSize="23" FontWeight="Bold"/><TextBlock Text="YOUR DESKTOP. YOUR CONSOLE." FontSize="9" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></StackPanel>
    <Border Grid.Column="1" Background="#141C2B" CornerRadius="20" Padding="16,8" Margin="20,16" VerticalAlignment="Center"><TextBox x:Name="SearchBox" TextChanged="OnSearch" Background="Transparent" BorderThickness="0" Foreground="#EDF1FA" CaretBrush="#82D9DF" FontSize="13" ToolTip="Cari game · Ctrl+F" AutomationProperties.Name="Cari game"/></Border>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Console" Click="OnConsole" ToolTip="F11"/><Button Content="Dock" Click="OnDock"/><Button Content="—" Click="OnMinimize" AutomationProperties.Name="Minimize"/><Button Content="×" Click="OnClose" AutomationProperties.Name="Close"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InfoColumn" Width="210"/></Grid.ColumnDefinitions>
    <DockPanel Margin="0,14,12,0">
     <StackPanel DockPanel.Dock="Bottom"><Button Content="＋ Add game" Click="OnAdd"/><Button x:Name="ScanButton" Content="↻ Scan library" Click="OnScan"/><Button Content="⚙ Settings" Click="OnSettings"/></StackPanel>
     <StackPanel><TextBlock Text="YOUR SPACE" FontSize="10" Foreground="{StaticResource Muted}" Margin="15,0,0,16"/><Button x:Name="LibraryTab" Content="◈   Library" Tag="Library" Click="OnFilter" Background="#73364A"/><Button x:Name="FavoriteTab" Content="♡   Favorites" Tag="Favorites" Click="OnFilter"/><Button x:Name="RecentTab" Content="◷   Recent" Tag="Recent" Click="OnFilter"/><TextBlock x:Name="CountText" Margin="15,22,4,0" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
    </DockPanel>
    <Grid Grid.Column="1" Margin="12,14,16,0">
     <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="185"/><RowDefinition Height="43"/><RowDefinition Height="210"/></Grid.RowDefinitions>
     <Border CornerRadius="28,40,24,12" BorderThickness="1" BorderBrush="#936077" ClipToBounds="True" Background="#253148">
      <Grid>
       <Grid Opacity="0.65"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#425F77"/><GradientStop Color="#563449" Offset="0.55"/><GradientStop Color="#182537" Offset="1"/></LinearGradientBrush></Grid.Background><Ellipse Width="165" Height="165" Fill="#BD8A97" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,26,0"/><Path Data="M0,260 L120,110 230,215 365,70 600,260Z" Fill="#27374B" Stretch="Fill" VerticalAlignment="Bottom" Height="155"/><Path Data="M0,150 L150,30 300,170 450,70 600,190Z" Fill="#182636" Stretch="Fill" VerticalAlignment="Bottom" Height="105"/></Grid>
       <Image Source="{Binding Selected.HeroPath}" Stretch="UniformToFill"/>
       <Border><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#F0121927"/><GradientStop Color="#B0121927" Offset="0.55"/><GradientStop Color="#30121927" Offset="1"/></LinearGradientBrush></Border.Background></Border>
       <StackPanel Margin="26" VerticalAlignment="Bottom"><TextBlock Text="{Binding Selected.SourceLabel, TargetNullValue=YOUR LIBRARY}" Foreground="#8ED9E2" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="{Binding Selected.Name, TargetNullValue=Your next adventure awaits}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="90" Margin="0,9,15,12"/><StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="▶  Play now" Background="#AD3E59" Click="OnPlay"/><Button Content="{Binding Selected.FavoriteLabel, TargetNullValue=♡ Favorite}" Click="OnFavorite"/></StackPanel></StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Row="1"><TextBlock x:Name="SectionTitle" Text="My library" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="← → select   ·   Enter play" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource Muted}"/></Grid>
     <Grid Grid.Row="2"><ListBox x:Name="GameList" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionChanged="OnSelection" MouseDoubleClick="OnGameDoubleClick" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid Width="124" Height="176"><Border CornerRadius="18,18,16,6" Background="#26374D"/><TextBlock Text="{Binding Initial}" FontSize="64" FontWeight="Bold" Foreground="#516580" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><Border CornerRadius="18,18,16,6"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00202B40"/><GradientStop Color="#F0101725" Offset="1"/></LinearGradientBrush></Border.Background></Border><StackPanel VerticalAlignment="Bottom" Margin="11"><TextBlock Text="{Binding SourceLabel}" FontSize="8" Foreground="#97D3DD"/><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="48" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyText" Text="Scan library atau tambah game untuk mulai." TextWrapping="Wrap" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
    </Grid>
    <StackPanel Grid.Column="2" Margin="0,14,0,0">
     <Border CornerRadius="24,24,24,10" Background="#263041" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="CONTROLLER" FontSize="10" Foreground="#A3B5CC"/><TextBlock x:Name="ControllerText" Text="Keyboard ready" FontSize="17" Margin="0,9,0,0"/><TextBlock Text="A play · X favorite · Y mode" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
     <Border CornerRadius="24,24,24,10" Background="#232D3E" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock Text="SYSTEM / LIVE" FontSize="10" Foreground="#A3B5CC"/><TextBlock x:Name="MemoryText" FontSize="20" Margin="0,12,0,0"/><TextBlock x:Name="PowerText" FontSize="12" Foreground="#8ED9E2" Margin="0,10,0,0"/><TextBlock x:Name="StorageText" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
     <Border CornerRadius="24,24,24,10" Background="#25283B" Padding="18"><StackPanel><TextBlock Text="MAKE IT YOURS" FontSize="10" Foreground="#B8A8DE"/><TextBlock Text="Console when you play. Desktop when you need it." TextWrapping="Wrap" FontSize="17" Margin="0,12,0,10"/><Button Content="Back to desktop" Click="OnDesktop"/><TextBlock Text="F11 console · Esc desktop" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="↝ Random game" Click="OnRandom" Padding="13,7"/><TextBlock x:Name="ClockText" VerticalAlignment="Center" Margin="14,0,2,0" FontSize="12"/></StackPanel></Grid>
  </Grid>
  <Grid x:Name="DockPanel" Visibility="Collapsed" Margin="22,12" MouseLeftButtonDown="OnDrag"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Button Content="◈ HUB" Click="OnDesktop" Padding="12,8"/><ListBox x:Name="DockList" Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="OnDockSelection" MouseDoubleClick="OnGameDoubleClick"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid Width="52" Height="54" ToolTip="{Binding Name}"><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"/><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="▶" Click="OnPlay" Padding="12,8"/><Button Content="↗" Click="OnConsole" Padding="12,8"/></StackPanel></Grid>
 </Grid>
</Window>
